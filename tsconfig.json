{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["es2017"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "baseUrl": "./src",
    "paths": {
      "@components": ["components"],
      "@components/*": ["components/*"],
      "@screens": ["screens"],
      "@screens/*": ["screens/*"],
      "@hooks": ["hooks"],
      "@hooks/*": ["hooks/*"],
      "@services": ["services"],
      "@services/*": ["services/*"],
      "@store": ["store"],
      "@store/*": ["store/*"],
      "@navigation": ["navigation"],
      "@navigation/*": ["navigation/*"],
      "@types": ["types"],
      "@types/*": ["types/*"],
      "@constants": ["constants"],
      "@constants/*": ["constants/*"],
      "@utils": ["utils"],
      "@utils/*": ["utils/*"],
      "@env": ["types/env.d.ts"]
    }
  },
  "exclude": ["node_modules", "babel.config.js"],
  "extends": "expo/tsconfig.base"
}
